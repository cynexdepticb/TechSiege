# Copy the two blocks below into the matching file. This app is fullstack — the
# site and the API are the same process (app/api/*), so the retired Express
# service's NEXT_PUBLIC_API_BASE, CORS_ORIGIN and PORT are gone and must not be
# added back.
#
#   .env       → the "Public" block. Non-secret, inlined into the browser bundle.
#   .env.local → the "Secrets" block. Server-only, never sent to the browser.
#
# Both are gitignored, so nothing here is published even if filled in with real
# values. See .env for the annotated version of the same layout.

# ─── .env.local — server-only secrets ───────────────────────────────────────
# Postgres connection string. Required for registration, the slot counter and
# the organizer dashboard. Without it the site still builds and serves, and the
# registration routes report "not configured".
DATABASE_URL=postgresql://user:password@localhost:5432/neondb?sslmode=verify-full

# Bearer token that unlocks /admin. Generate one:  openssl rand -hex 24
# Leave unset to disable the admin API entirely (it returns 503).
ADMIN_TOKEN=change-me-to-a-long-random-string

# ─── .env — public, inlined at build time ───────────────────────────────────
# Read by lib/content.ts. Changing it needs a rebuild or dev-server restart.
NEXT_PUBLIC_EVENT_NAME=TechSiege

# Read only by app/api/config/route.ts, at request time, so these take effect
# without a rebuild. Each falls back to the matching value in lib/content.ts.
#
# EVENT_START_ISO changes what /api/config reports, but the schedule and
# countdown on the page come from the constant in lib/content.ts — to move the
# event date on the site, edit that file too.
EVENT_NAME=TechSiege
EVENT_START_ISO=2026-10-30T08:00:00+05:30
REGISTRATION_URL=/register
